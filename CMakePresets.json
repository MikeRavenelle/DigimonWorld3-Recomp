{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-x64-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-x64-release",
      "inherits": "linux-x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-arm64-debug",
      "inherits": "linux-x64-debug"
    },
    {
      "name": "linux-arm64-release",
      "inherits": "linux-x64-release"
    },
    {
      "name": "linux-arm64-cross-debug",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DW3_BUILD_APP": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-arm64-cross-release",
      "inherits": "linux-arm64-cross-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "macos-arm64-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "macos-arm64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-x64-cross-debug",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DW3_BUILD_APP": "ON"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-cross-release",
      "inherits": "windows-x64-cross-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-release",
      "inherits": "windows-x64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "linux-arm64-debug", "configurePreset": "linux-arm64-debug" },
    { "name": "linux-arm64-release", "configurePreset": "linux-arm64-release" },
    { "name": "linux-arm64-cross-debug", "configurePreset": "linux-arm64-cross-debug" },
    { "name": "linux-arm64-cross-release", "configurePreset": "linux-arm64-cross-release" },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "windows-x64-cross-debug", "configurePreset": "windows-x64-cross-debug" },
    { "name": "windows-x64-cross-release", "configurePreset": "windows-x64-cross-release" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" }
  ],
  "testPresets": [
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release", "output": { "outputOnFailure": true } },
    { "name": "linux-arm64-debug", "configurePreset": "linux-arm64-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-arm64-release", "configurePreset": "linux-arm64-release", "output": { "outputOnFailure": true } },
    { "name": "linux-arm64-cross-debug", "configurePreset": "linux-arm64-cross-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-arm64-cross-release", "configurePreset": "linux-arm64-cross-release", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64-debug", "configurePreset": "macos-arm64-debug", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-cross-debug", "configurePreset": "windows-x64-cross-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-cross-release", "configurePreset": "windows-x64-cross-release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "output": { "outputOnFailure": true } }
  ]
}
