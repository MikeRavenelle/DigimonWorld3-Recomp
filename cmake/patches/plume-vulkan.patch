--- a/plume_render_interface_types.h
+++ b/plume_render_interface_types.h
@@ -43,10 +43,15 @@ namespace plume {
     typedef SDL_Window *RenderWindow;
 #elif defined(__linux__)
     struct RenderWindow {
-        Display* display;
-        Window window;
+        Display* display = nullptr;
+        Window window = 0;
+        // Optional: a window described by callbacks instead of X11 handles (e.g. SDL, which covers Wayland too).
+        // createSurface returns a VkSurfaceKHR handle for the given VkInstance; getSize returns the size in pixels.
+        void* userData = nullptr;
+        uint64_t (*createSurface)(void* userData, void* vkInstance) = nullptr;
+        void (*getSize)(void* userData, uint32_t* width, uint32_t* height) = nullptr;
         bool operator==(const struct RenderWindow& rhs) const {
-            return display == rhs.display && window == rhs.window;
+            return display == rhs.display && window == rhs.window && userData == rhs.userData;
         }
         bool operator!=(const struct RenderWindow& rhs) const { return !(*this == rhs); }
     };
