+    bool setLayerExtendedRange(void* metalLayer, void* window, bool enable) {
+        CAMetalLayer *layer = (__bridge CAMetalLayer *)metalLayer;
+        NSWindow *nsWindow = (__bridge NSWindow *)window;
+        layer.wantsExtendedDynamicRangeContent = enable;
+        CGColorSpaceRef colorSpace = enable ? CGColorSpaceCreateWithName(kCGColorSpaceExtendedLinearSRGB) : nullptr;
+        layer.colorspace = colorSpace;
+        if (colorSpace != nullptr) {
+            CGColorSpaceRelease(colorSpace);
+        }
+        if (!enable) {
+            return false;
+        }
+        NSScreen *screen = [nsWindow screen] ?: [NSScreen mainScreen];
+        return screen != nil && [screen maximumPotentialExtendedDynamicRangeColorComponentValue] > 1.0;
+    }
+
+    float getExtendedRangeHeadroom(void* window) {
+        NSWindow *nsWindow = (__bridge NSWindow *)window;
+        NSScreen *screen = [nsWindow screen] ?: [NSScreen mainScreen];
+        return screen != nil ? (float)[screen maximumExtendedDynamicRangeColorComponentValue] : 1.0f;
+    }
